		"@wordpress/plugins": "^7.55.0",
		"@wordpress/url": "^4.55.0",
		"moment": "^2.30.1",
		"react-copy-to-clipboard": "^5.1.1",
		"react-select": "^5.10.2"
	},
	"overrides": {
